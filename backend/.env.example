# Copy to .env and fill in. Never commit the filled-in file.

# --- Anthropic (required) -----------------------------------------------
# Powers the /chat route. https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase (required) ------------------------------------------------
# Project URL and anon key from Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# --- Stripe (required for billing) --------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Server -------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3001
# Base URL of the dashboard, used for Stripe success/cancel redirects.
APP_URL=http://localhost:5173

# --- ElevenLabs (optional, /tts is not implemented yet) -----------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
